# SimpliXio Fastlane Configuration
# ---------------------------------
# Automated build + TestFlight deployment for iOS, macOS, and watchOS.
# Uses App Store Connect API Key for authentication (no password/2FA needed).
#
# Usage:
#   cd CortexOSApp
#   fastlane ios_testflight version:1.1.3    — build iOS + upload to TestFlight
#   fastlane mac_testflight version:1.1.3    — build macOS + upload to TestFlight
#   fastlane all_testflight version:1.1.3    — iOS + macOS + watchOS (shared build number)

default_platform(:ios)
require "fileutils"
require "open3"
require "rubygems"
require "shellwords"
require "spaceship"

# All sensitive values are loaded from fastlane/.env (never committed).
# See fastlane/.env.example for the required keys.
TEAM_ID       = ENV.fetch("TEAM_ID")                    unless defined?(TEAM_ID)
IOS_BUNDLE    = ENV.fetch("IOS_BUNDLE")                  unless defined?(IOS_BUNDLE)
WIDGET_BUNDLE = ENV.fetch("WIDGET_BUNDLE")               unless defined?(WIDGET_BUNDLE)
MAC_BUNDLE    = ENV.fetch("MAC_BUNDLE")                  unless defined?(MAC_BUNDLE)
WATCH_BUNDLE  = ENV.fetch("WATCH_BUNDLE")                unless defined?(WATCH_BUNDLE)
PROJECT       = "CortexOS.xcodeproj"                    unless defined?(PROJECT)
APP_ROOT      = File.expand_path("..", __dir__)          unless defined?(APP_ROOT)

# App Store Connect API Key
ASC_KEY_ID   = ENV.fetch("ASC_KEY_ID")                   unless defined?(ASC_KEY_ID)
ASC_ISSUER   = ENV.fetch("ASC_ISSUER")                   unless defined?(ASC_ISSUER)
ASC_KEY_PATH = File.expand_path(ENV.fetch("ASC_KEY_PATH")) unless defined?(ASC_KEY_PATH)

unless File.file?(ASC_KEY_PATH)
  UI.user_error!("ASC_KEY_PATH must point to an existing App Store Connect API key file.")
end

# Xcargs for automatic provisioning with API key
SIGN_ARGS = [
  "DEVELOPMENT_TEAM=#{TEAM_ID}",
  "CODE_SIGN_STYLE=Automatic",
  "-allowProvisioningUpdates",
  "-authenticationKeyPath #{ASC_KEY_PATH}",
  "-authenticationKeyID #{ASC_KEY_ID}",
  "-authenticationKeyIssuerID #{ASC_ISSUER}",
].join(" ") unless defined?(SIGN_ARGS)

# ── Xcode project regen ────────────────────────────────────

before_all do
  if system("which xcodegen > /dev/null 2>&1")
    sh("cd .. && LOCAL_YAML=1 xcodegen generate 2>&1")
    UI.message("Regenerated Xcode project from project.yml (with local team settings)")
  end

  # Authenticate with App Store Connect API
  app_store_connect_api_key(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER,
    key_filepath: ASC_KEY_PATH,
    duration: 1200,
    in_house: false,
  )
end

# ── Release version helpers ────────────────────────────────

def resolve_release_version(options = {})
  value = options[:version] || ENV["VERSION_NUMBER"] || ENV["APP_VERSION"]
  value = value.to_s.strip
  value.empty? ? nil : value
end

def next_patch_version(version)
  match = version.to_s.strip.match(/^(\d+)\.(\d+)\.(\d+)$/)
  UI.user_error!("Invalid MARKETING_VERSION '#{version}'. Expected semantic version x.y.z.") unless match

  major = match[1].to_i
  minor = match[2].to_i
  patch = match[3].to_i + 1
  "#{major}.#{minor}.#{patch}"
end

def parse_semver(version)
  Gem::Version.new(version.to_s.strip)
rescue StandardError
  nil
end

def fetch_latest_store_version(bundle_id:, platform:)
  app = Spaceship::ConnectAPI::App.find(bundle_id: bundle_id)
  return nil if app.nil?

  # Spaceship API accepts positional platform string (e.g. "IOS", "MAC_OS")
  platform_str = platform.to_s
  latest = app.get_latest_app_store_version(platform_str)
  return nil if latest.nil?

  version = latest.version_string.to_s.strip
  return nil if version.empty?

  parse_semver(version) ? version : nil
rescue StandardError => e
  UI.important("Could not read latest App Store version for #{bundle_id} (#{platform}): #{e.message}")
  nil
end

def highest_version(candidates)
  versions = candidates
    .map { |v| [v, parse_semver(v)] }
    .reject { |(_, semver)| semver.nil? }

  return nil if versions.empty?

  versions.max_by { |(_, semver)| semver }.first
end

def next_safe_auto_version(current_version)
  latest_ios = fetch_latest_store_version(
    bundle_id: IOS_BUNDLE,
    platform: Spaceship::ConnectAPI::Platform::IOS,
  )
  latest_mac = fetch_latest_store_version(
    bundle_id: MAC_BUNDLE,
    platform: Spaceship::ConnectAPI::Platform::MAC_OS,
  )

  if latest_ios.nil? && latest_mac.nil?
    UI.important("Could not query App Store versions — falling back to bumping current project version #{current_version}.")
    return next_patch_version(current_version)
  end

  baseline = highest_version([current_version, latest_ios, latest_mac])
  UI.user_error!("Unable to determine baseline release version.") if baseline.nil?

  next_patch_version(baseline)
end

def apply_release_version_if_requested(options = {})
  current_version = get_version_number(
    xcodeproj: PROJECT,
    target: "CortexOS-iOS",
  )
  requested_version = resolve_release_version(options)

  if requested_version.nil?
    bumped_version = next_safe_auto_version(current_version)
    UI.success("Will build with MARKETING_VERSION #{bumped_version} (safe auto-version from #{current_version}).")
    return bumped_version
  end

  unless requested_version.match?(/^\d+\.\d+\.\d+$/)
    UI.user_error!("Invalid version '#{requested_version}'. Use semantic version format x.y.z.")
  end

  UI.message("Will build with MARKETING_VERSION #{requested_version}.")
  requested_version
end

def next_build_number
  Time.now.utc.strftime("%Y%m%d%H%M%S")
end

def project_spec_path
  File.join(APP_ROOT, "project.yml")
end

def persist_project_release_settings!(version:, build_number:)
  spec_path = project_spec_path
  UI.user_error!("Missing project spec at #{spec_path}") unless File.file?(spec_path)

  contents = File.read(spec_path)
  updated = contents
    .sub(/^(\s*MARKETING_VERSION:\s*)"[^"]*"/, "\\1\"#{version}\"")
    .sub(/^(\s*CURRENT_PROJECT_VERSION:\s*)"[^"]*"/, "\\1\"#{build_number}\"")

  if updated == contents
    UI.user_error!("Unable to update MARKETING_VERSION/CURRENT_PROJECT_VERSION in #{spec_path}.")
  end

  File.write(spec_path, updated)
  sh("cd .. && LOCAL_YAML=1 xcodegen generate 2>&1")
  UI.success("Persisted release version #{version} build #{build_number} in project.yml and regenerated the Xcode project.")
end

def resolve_build_number(options = {})
  explicit = options[:build_number] || ENV["BUILD_NUMBER"]
  value = explicit.to_s.strip
  return value unless value.empty?

  next_build_number
end

def xcodebuild_output(*args)
  Dir.chdir(APP_ROOT) do
    Open3.capture2e("xcodebuild", *args)
  end
end

def shell_join(args)
  args.map(&:to_s).shelljoin
end

def write_export_options(path, method:)
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>#{method}</string>
      <key>signingStyle</key>
      <string>automatic</string>
      <key>teamID</key>
      <string>#{TEAM_ID}</string>
    </dict>
    </plist>
  PLIST
end

def ios_project_embeds_watch?
  pbxproj = File.join(APP_ROOT, PROJECT, "project.pbxproj")
  File.file?(pbxproj) && File.read(pbxproj).include?("Embed Watch Content")
end

def verify_embedded_watch_ipa!(ipa_path)
  UI.user_error!("iOS IPA path is missing, so the embedded watch app cannot be verified.") if ipa_path.to_s.empty?
  UI.user_error!("iOS IPA does not exist at #{ipa_path}.") unless File.file?(ipa_path)

  contents, status = Open3.capture2e("unzip", "-Z1", ipa_path)
  unless status.success?
    UI.user_error!("Unable to inspect iOS IPA for embedded watch app: #{contents}")
  end

  has_watch_app = contents.lines.any? do |line|
    line.match?(%r{^Payload/[^/]+\.app/Watch/[^/]+\.app/$})
  end

  UI.user_error!("iOS IPA does not include an embedded watchOS app under Payload/*.app/Watch/.") unless has_watch_app

  UI.success("Verified iOS IPA includes the embedded watchOS app.")
end

# ── iOS TestFlight ──────────────────────────────────────────

platform :ios do
  desc "Build iOS and upload to TestFlight"
  lane :testflight_release do |options|
    version      = apply_release_version_if_requested(options)
    build_number = resolve_build_number(options)

    build_app(
      project: PROJECT,
      scheme: "CortexOS-iOS",
      clean: true,
      export_method: "app-store",
      xcargs: "#{SIGN_ARGS} MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      app_identifier: IOS_BUNDLE,
      uses_non_exempt_encryption: false,
    )

    UI.success("iOS build #{build_number} (#{version}) uploaded to TestFlight.")
  end
end

# ── macOS TestFlight ────────────────────────────────────────

platform :mac do
  desc "Build macOS and upload to TestFlight"
  lane :testflight_release do |options|
    version      = apply_release_version_if_requested(options)
    build_number = resolve_build_number(options)

    build_app(
      project: PROJECT,
      scheme: "CortexOS-macOS",
      clean: true,
      export_method: "app-store",
      xcargs: "#{SIGN_ARGS} MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      app_platform: "osx",
      app_identifier: MAC_BUNDLE,
      uses_non_exempt_encryption: false,
      pkg: lane_context[SharedValues::PKG_OUTPUT_PATH],
    )

    UI.success("macOS build #{build_number} (#{version}) uploaded to TestFlight.")
  end
end

# ── Convenience aliases ─────────────────────────────────────

desc "iOS TestFlight (alias)"
lane :ios_testflight do |options|
  Fastlane::LaneManager.cruise_lane("ios", "testflight_release", options)
end

desc "macOS TestFlight (alias)"
lane :mac_testflight do |options|
  Fastlane::LaneManager.cruise_lane("mac", "testflight_release", options)
end

desc "watchOS TestFlight"
lane :watch_testflight do |options|
  strict_watch_publish = if options[:strict_watch].nil?
    true
  else
    !["false", "0", "no"].include?(options[:strict_watch].to_s.strip.downcase)
  end
  destinations, status = xcodebuild_output(
    "-showdestinations",
    "-scheme",
    "CortexOS-watchOS",
    "-project",
    PROJECT,
  )

  has_watch_destination = status.success? && destinations.include?("platform:watchOS")
  has_missing_platform_error = destinations.include?("is not installed")

  if !has_watch_destination || has_missing_platform_error
    message = "watchOS upload blocked: watchOS platform is not available in this Xcode install."
    install_hint = "Install watchOS from Xcode > Settings > Components, then run `fastlane watch_testflight`."
    if strict_watch_publish
      UI.user_error!("#{message} #{install_hint}")
    else
      UI.important("Skipping watchOS upload: #{message}")
      UI.important(install_hint)
      next
    end
  end

  version      = apply_release_version_if_requested(options)
  build_number = resolve_build_number(options)
  watch_build_root = File.join(APP_ROOT, "build", "watchos-testflight")
  archive_path = File.join(watch_build_root, "SimpliXio Watch #{build_number}.xcarchive")
  export_path = File.join(watch_build_root, "export")
  export_options_path = File.join(watch_build_root, "ExportOptions.plist")

  FileUtils.rm_rf(watch_build_root)
  FileUtils.mkdir_p(export_path)
  write_export_options(export_options_path, method: "release-testing")

  archive_args = [
    "xcodebuild",
    "-scheme", "CortexOS-watchOS",
    "-project", PROJECT,
    "-destination", "generic/platform=watchOS",
    "-archivePath", archive_path,
    "DEVELOPMENT_TEAM=#{TEAM_ID}",
    "CODE_SIGN_STYLE=Automatic",
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", ASC_KEY_PATH,
    "-authenticationKeyID", ASC_KEY_ID,
    "-authenticationKeyIssuerID", ASC_ISSUER,
    "MARKETING_VERSION=#{version}",
    "CURRENT_PROJECT_VERSION=#{build_number}",
    "SKIP_INSTALL=NO",
    "clean",
    "archive",
  ]

  export_args = [
    "xcodebuild",
    "-exportArchive",
    "-archivePath", archive_path,
    "-exportOptionsPlist", export_options_path,
    "-exportPath", export_path,
    "DEVELOPMENT_TEAM=#{TEAM_ID}",
    "CODE_SIGN_STYLE=Automatic",
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", ASC_KEY_PATH,
    "-authenticationKeyID", ASC_KEY_ID,
    "-authenticationKeyIssuerID", ASC_ISSUER,
  ]

  Dir.chdir(APP_ROOT) do
    sh(shell_join(archive_args))
    sh(shell_join(export_args))
  end

  ipa_path = Dir[File.join(export_path, "*.ipa")].first
  UI.user_error!("watchOS export did not produce an IPA in #{export_path}.") if ipa_path.nil?

  upload_to_testflight(
    ipa: ipa_path,
    skip_waiting_for_build_processing: true,
    app_identifier: WATCH_BUNDLE,
    uses_non_exempt_encryption: false,
  )

  UI.success("watchOS build #{build_number} uploaded to TestFlight.")
end

desc "Build and upload iOS, macOS, and watchOS to TestFlight"
lane :all_testflight do |options|
  shared_build_number = resolve_build_number(options)

  # Resolve version ONCE here so that xcodegen resets inside before_all
  # (which runs before each sub-lane) do not cause each platform to
  # independently re-compute and land on the same already-approved version.
  current_version = get_version_number(
    xcodeproj: PROJECT,
    target: "CortexOS-iOS",
  )
  requested_version = resolve_release_version(options)
  shared_version = if requested_version.nil?
    next_safe_auto_version(current_version)
  else
    requested_version
  end

  unless shared_version.match?(/^\d+\.\d+\.\d+$/)
    UI.user_error!("Invalid version '#{shared_version}'. Use semantic version format x.y.z.")
  end

  persist_project_release_settings!(
    version: shared_version,
    build_number: shared_build_number,
  )

  UI.message("Using shared build number #{shared_build_number} and version #{shared_version} for iOS, macOS, and watchOS.")

  watch_embedded = ios_project_embeds_watch?

  # Preflight watchOS before uploading anything so all_testflight cannot partially
  # publish iOS/macOS while silently missing the watch app.
  watchos_available = false
  unless watch_embedded
    watch_destinations, watch_status = xcodebuild_output(
      "-showdestinations", "-scheme", "CortexOS-watchOS", "-project", PROJECT,
    )
    watchos_available = watch_status.success? &&
                        watch_destinations.match?(/platform:watchOS[, ]/) &&
                        !watch_destinations.include?("is not installed")
  end

  strict_watch = if options.key?(:strict_watch)
    !["false", "0", "no"].include?(options[:strict_watch].to_s.strip.downcase)
  else
    true
  end

  shared_options = options.merge(
    build_number: shared_build_number,
    version: shared_version,
    strict_watch: strict_watch,
  )

  if watch_embedded
    UI.message("watchOS app is embedded in the iOS archive — all_testflight will verify the iOS IPA includes Watch content.")
  elsif watchos_available
    UI.message("watchOS platform detected — will upload standalone watchOS build.")
  elsif strict_watch
    UI.user_error!(
      "watchOS upload blocked before iOS/macOS upload: watchOS platform is not available. " \
      "Install watchOS from Xcode > Settings > Components, then rerun `fastlane all_testflight`."
    )
  else
    UI.important("watchOS platform not detected in this Xcode install — skipping watchOS upload.")
    UI.important("Install watchOS from Xcode > Settings > Components to enable watchOS uploads.")
  end

  Fastlane::LaneManager.cruise_lane("ios", "testflight_release", shared_options)
  verify_embedded_watch_ipa!(lane_context[SharedValues::IPA_OUTPUT_PATH]) if watch_embedded
  UI.success("iOS TestFlight upload completed.")
  Fastlane::LaneManager.cruise_lane("mac", "testflight_release", shared_options)
  UI.success("macOS TestFlight upload completed.")
  if watch_embedded
    UI.success("watchOS TestFlight delivery completed through the embedded iOS app.")
  else
    watch_testflight(shared_options)
    UI.success("watchOS TestFlight upload completed.")
  end
end

desc "Regenerate App Store provisioning profiles (iOS app + widget)"
lane :refresh_profiles do
  sigh(
    app_identifier: IOS_BUNDLE,
    skip_install: false,
    skip_certificate_verification: true
  )

  sigh(
    app_identifier: WIDGET_BUNDLE,
    skip_install: false,
    skip_certificate_verification: true
  )
end

desc "Generate App Store screenshot assets (iOS/macOS/watchOS)"
lane :generate_store_assets do
  sh("cd .. && ./.venv/bin/python scripts/generate_store_assets.py")
end
